{
  "name": "dapur-parto",
  "version": "1.0.0",
  "private": true,
  "description": "Dapur Parto — Order Management (web + Android via Capacitor)",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && npx cap sync android",
    "icons": "npx capacitor-assets generate --android --iconBackgroundColor '#F4F5F3' --splashBackgroundColor '#F4F5F3'",
    "apk": "npm run sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "@supabase/supabase-js": "^2.118.0",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0"
  }
}
